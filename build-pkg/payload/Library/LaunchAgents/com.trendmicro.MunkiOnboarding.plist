<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.trendmicro.MunkiOnboarding</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/MunkiOnboarding.app/Contents/MacOS/MunkiOnboarding</string>
	</array>
	<!-- Run in the logged-in user's Aqua session (after login) -->
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<!-- Disable relaunching if the app exits (e.g. after logout) -->
	<key>ThrottleInterval</key>
	<integer>0</integer>
</dict>
</plist>
