<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No sandbox: must read /Library/Managed Installs (root-owned dir),
	     write /Users/Shared/.SelfServeManifest, and spawn osascript for logout -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Required for Xcode debugger (LLDB) to attach to the process -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
